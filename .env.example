# Module APIs (each service is deployed separately)
VITE_AUTH_API_URL=http://localhost:4001
VITE_STUDENT_API_URL=http://localhost:4002
VITE_INCIDENT_API_URL=http://localhost:4003
VITE_CASE_API_URL=http://localhost:4004
VITE_REPORT_API_URL=http://localhost:4005
VITE_ANALYTICS_API_URL=http://localhost:4006

# Used only by `npm run db:setup` (creates the database, tables and first admin)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-at-least-8-chars
# true = load fictional sample students and cases into an empty database
SEED_SAMPLE_DATA=false

# Docker (docker compose up) — use long random values
MYSQL_ROOT_PASSWORD=change-me
MYSQL_PASSWORD=change-me-too
JWT_SECRET=change-me-to-a-long-random-string
